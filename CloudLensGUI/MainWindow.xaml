<Window x:Class="CloudLensGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="C:\Users\zdjpu\Documents\CloudLens\assets\CloudLens.ico"
        Title="CloudLens — Azure Environment Analyzer"
        Height="900"
        Width="1450"
        MinHeight="700"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F7FA">

        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- =====================================================
             HEADER
             ===================================================== -->

        <Border Background="#0D1524">

            <DockPanel Margin="28,0">

                <TextBlock Text="CloudLens"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock Text="Azure Environment Analyzer"
                           Foreground="#AFC1D8"
                           FontSize="13"
                           Margin="14,7,0,0"
                           VerticalAlignment="Center"/>

            </DockPanel>

        </Border>


        <!-- =====================================================
             MAIN CONTENT
             ===================================================== -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="36">


                <!-- =================================================
                     TITLE
                     ================================================= -->

                <StackPanel Orientation="Horizontal">

                    <StackPanel>

                        <TextBlock Text="Azure Assessment"
                                   FontSize="30"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Analisi read-only dell'ambiente Azure"
                                   Foreground="#5E6B7A"
                                   Margin="0,6,0,0"/>

                    </StackPanel>

                    <Button x:Name="DemoButton"
                            Content="Carica demo"
                            Click="Demo_Click"
                            Margin="30,0,0,0"
                            VerticalAlignment="Center"/>

                </StackPanel>


                <!-- =================================================
                     AZURE CONNECTION
                     ================================================= -->

                <Border Background="White"
                        CornerRadius="10"
                        Padding="24"
                        BorderBrush="#E1E6EC"
                        BorderThickness="1"
                        Margin="0,25,0,0">

                    <StackPanel>

                        <TextBlock Text="Connessione Azure"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Accesso interattivo tramite account Microsoft"
                                   Foreground="#687687"
                                   FontSize="12"
                                   Margin="0,4,0,15"/>


                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <!-- TENANT -->

                            <StackPanel Margin="0,0,20,0">

                                <TextBlock Text="Tenant ID"
                                           FontWeight="SemiBold"/>

                                <TextBox x:Name="Tenant"
                                         Height="34"
                                         Margin="0,6,0,0"/>

                            </StackPanel>


                            <!-- LOGIN -->

                            <Button x:Name="LoginButton"
                                    Grid.Column="1"
                                    Content="Accedi con Microsoft"
                                    Click="Login_Click"
                                    Height="36"
                                    Padding="20,0"
                                    VerticalAlignment="Bottom"/>

                        </Grid>


                        <TextBlock Text="Il browser Microsoft verrà aperto per autenticare l'account. CloudLens utilizza esclusivamente i permessi già assegnati al tuo account Azure."
                                   Foreground="#687687"
                                   FontSize="12"
                                   Margin="0,12,0,0"/>

                    </StackPanel>

                </Border>


                <!-- =================================================
                     ASSESSMENT CONFIGURATION
                     ================================================= -->

                <Border Background="White"
                        CornerRadius="10"
                        Padding="24"
                        BorderBrush="#E1E6EC"
                        BorderThickness="1"
                        Margin="0,20,0,0">

                    <StackPanel>

                        <TextBlock Text="Configurazione assessment"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>


                        <TextBlock Text="Subscription"
                                   FontWeight="SemiBold"
                                   Margin="0,15,0,6"/>


                        <ComboBox x:Name="Subscription"
                                  Height="35"/>


                        <!-- METRIC WINDOW -->

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,18,0,0">

                            <TextBlock Text="Finestra metriche:"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>


                            <RadioButton x:Name="Metrics7"
                                         Content="7 giorni"
                                         Margin="20,0,0,0"
                                         IsChecked="True"
                                         VerticalAlignment="Center"/>


                            <RadioButton x:Name="Metrics30"
                                         Content="30 giorni"
                                         Margin="15,0,0,0"
                                         VerticalAlignment="Center"/>


                            <RadioButton x:Name="Metrics90"
                                         Content="90 giorni"
                                         Margin="15,0,0,0"
                                         VerticalAlignment="Center"/>


                            <Button x:Name="RunAssessmentButton"
                                    Content="Avvia assessment"
                                    Click="Run_Click"
                                    Margin="20,0,0,0"/>

                        </StackPanel>

                    </StackPanel>

                </Border>


                <!-- =================================================
                     STATUS
                     ================================================= -->

                <Border x:Name="StatusPanel"
                        Background="White"
                        CornerRadius="10"
                        Padding="20"
                        BorderBrush="#E1E6EC"
                        BorderThickness="1"
                        Margin="0,20,0,0"
                        Visibility="Collapsed">

                    <StackPanel>

                        <TextBlock Text="Stato assessment"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>


                        <TextBlock x:Name="StatusText"
                                   Text="In attesa..."
                                   Margin="0,10,0,0"/>


                        <ProgressBar x:Name="Progress"
                                     Height="8"
                                     Margin="0,12,0,0"
                                     Minimum="0"
                                     Maximum="100"/>

                    </StackPanel>

                </Border>


                <!-- =================================================
                     RESULTS
                     ================================================= -->

                <StackPanel x:Name="Results"
                            Visibility="Collapsed"
                            Margin="0,25,0,0">


                    <TextBlock Text="Risultati"
                               FontSize="22"
                               FontWeight="SemiBold"/>


                    <!-- =================================================
                         KPI
                         ================================================= -->

                    <Grid Margin="0,12,0,20">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition/>

                            <ColumnDefinition/>

                            <ColumnDefinition/>

                            <ColumnDefinition/>

                        </Grid.ColumnDefinitions>


                        <!-- SCORE -->

                        <Border Background="White"
                                Padding="18"
                                Margin="0,0,8,0"
                                CornerRadius="8">

                            <StackPanel>

                                <TextBlock Text="Punteggio"
                                           Foreground="#667085"/>

                                <TextBlock x:Name="Score"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="#087EA4"/>

                            </StackPanel>

                        </Border>


                        <!-- FINDINGS -->

                        <Border Grid.Column="1"
                                Background="White"
                                Padding="18"
                                Margin="8,0"
                                CornerRadius="8">

                            <StackPanel>

                                <TextBlock Text="Rilievi"
                                           Foreground="#667085"/>

                                <TextBlock x:Name="FindingCount"
                                           FontSize="30"
                                           FontWeight="Bold"/>

                            </StackPanel>

                        </Border>


                        <!-- MONTHLY SAVING -->

                        <Border Grid.Column="2"
                                Background="White"
                                Padding="18"
                                Margin="8,0"
                                CornerRadius="8">

                            <StackPanel>

                                <TextBlock Text="Risparmio / mese"
                                           Foreground="#667085"/>

                                <TextBlock x:Name="Saving"
                                           FontSize="30"
                                           FontWeight="Bold"/>

                            </StackPanel>

                        </Border>


                        <!-- YEARLY SAVING -->

                        <Border Grid.Column="3"
                                Background="White"
                                Padding="18"
                                Margin="8,0"
                                CornerRadius="8">

                            <StackPanel>

                                <TextBlock Text="Risparmio / anno"
                                           Foreground="#667085"/>

                                <TextBlock x:Name="SavingYear"
                                           FontSize="30"
                                           FontWeight="Bold"/>

                            </StackPanel>

                        </Border>

                    </Grid>


                    <!-- =================================================
                         FINDINGS
                         ================================================= -->

                    <TextBlock Text="Rilievi"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,5,0,8"/>


                    <DataGrid x:Name="FindingsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MinHeight="350"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">


                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Categoria"
                                                Binding="{Binding Category}"
                                                Width="130"/>


                            <DataGridTextColumn Header="Gravità"
                                                Binding="{Binding Severity}"
                                                Width="100"/>


                            <DataGridTextColumn Header="Rule"
                                                Binding="{Binding RuleId}"
                                                Width="150"/>


                            <DataGridTextColumn Header="Titolo"
                                                Binding="{Binding Title}"
                                                Width="2*"/>


                            <DataGridTextColumn Header="Risorsa"
                                                Binding="{Binding ResourceName}"
                                                Width="*"/>


                            <DataGridTextColumn Header="Tipo risorsa"
                                                Binding="{Binding ResourceType}"
                                                Width="220"/>


                            <DataGridTextColumn Header="€/mese"
                                                Binding="{Binding MonthlySavingEur,StringFormat=N2}"
                                                Width="110"/>

                        </DataGrid.Columns>

                    </DataGrid>


                    <!-- =================================================
                         METRICS
                         ================================================= -->

                    <TextBlock Text="Metriche Azure"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,30,0,8"/>


                    <TextBlock Text="Metriche disponibili raccolte da Azure Monitor per le risorse rilevate."
                               Foreground="#687687"
                               FontSize="12"
                               Margin="0,0,0,10"/>


                    <DataGrid x:Name="MetricsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MinHeight="400"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">


                        <DataGrid.Columns>


                            <!-- RESOURCE -->

                            <DataGridTextColumn Header="Risorsa"
                                                Binding="{Binding ResourceName}"
                                                Width="*"/>


                            <!-- RESOURCE TYPE -->

                            <DataGridTextColumn Header="Tipo"
                                                Binding="{Binding ResourceType}"
                                                Width="240"/>


                            <!-- METRIC -->

                            <DataGridTextColumn Header="Metrica"
                                                Binding="{Binding MetricName}"
                                                Width="200"/>


                            <!-- AVERAGE -->

                            <DataGridTextColumn Header="Media"
                                                Binding="{Binding Average,StringFormat=N2}"
                                                Width="100"/>


                            <!-- MINIMUM -->

                            <DataGridTextColumn Header="Min"
                                                Binding="{Binding Minimum,StringFormat=N2}"
                                                Width="100"/>


                            <!-- MAXIMUM -->

                            <DataGridTextColumn Header="Max"
                                                Binding="{Binding Maximum,StringFormat=N2}"
                                                Width="100"/>


                            <!-- SAMPLES -->

                            <DataGridTextColumn Header="Campioni"
                                                Binding="{Binding SampleCount}"
                                                Width="90"/>


                            <!-- LOOKBACK -->

                            <DataGridTextColumn Header="Giorni"
                                                Binding="{Binding LookbackDays}"
                                                Width="80"/>

                        </DataGrid.Columns>

                    </DataGrid>


                </StackPanel>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Window>